# Environment configuration
# Copy this file to .env.local for local development and fill in values.
# Never commit .env.local or any file containing real secrets.

# The canonical public URL of the website (no trailing slash)
# Used for SEO canonical URLs, sitemap, and Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For production deployment, set this to your actual domain:
# NEXT_PUBLIC_SITE_URL=https://www.promptora.com
